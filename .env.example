# Copier ce fichier vers .env ou exécuter npm run setup:env.
# Remplacer les valeurs CHANGE_ME avant le démarrage.
POSTGRES_USER=orange
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orange
DATABASE_URL=postgresql://orange:CHANGE_ME@localhost:5434/orange?schema=public
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
DEMO_PASSWORD=CHANGE_ME_DEVELOPMENT_ONLY
# Configuration facultative pour les liens de récupération de compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Orange <no-reply@example.com>
# Création d’une véritable entreprise avec npm run company:create :
# COMPANY_NAME=Mon Entreprise SARL
# ADMIN_NAME=Prénom Nom
# ADMIN_EMAIL=admin@entreprise.fr
# ADMIN_PASSWORD=Un_mot_de_passe_unique_et_long
# TRUST_PROXY=true uniquement derrière un proxy de confiance qui remplace X-Forwarded-For.
